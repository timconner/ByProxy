
<section>
    <div class="section-header" style="@(string.IsNullOrWhiteSpace(MarginTop) ? null : $"margin-top:{MarginTop};")" @onclick="ToggleExpanded">
        <Icon Name="@(_expanded ? "caret-down" : "caret-right-filled")" />
        <div class="section-divider" />
        <div class="section-label">@Label</div>
        <div class="section-divider" />
    </div>
    <div class="section-content" style="display:@(_expanded ? "block" : "none")">
        @ChildContent
    </div>
    @if (!DisableCollapsedContent && CollapsedContent != null) {
        <div class="section-collapsed" style="display:@(_expanded ? "none" : "block")" @onclick="ToggleExpanded">
            @CollapsedContent
        </div>
    }
</section>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? MarginTop { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public bool DisableCollapsedContent { get; set; }

    [Parameter]
    public RenderFragment? CollapsedContent { get; set; }

    [Parameter]
    public bool StartExpanded { get; set; } = false;

    private bool _expanded = false;

    protected override void OnInitialized() {
        _expanded = StartExpanded;
        if (Content != null) ChildContent = Content;
    }

    private void ToggleExpanded() {
        _expanded = !_expanded;
    }
}
