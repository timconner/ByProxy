@page "/system"
@attribute [Authorize(Roles = AuthRoles.Admin)]
@inject IStringLocalizer<Language> _strings
@inject IDbContextFactory<ProxyDb> _dbFactory
@inject ProxyStateService _proxyState
@inject ModalService _modal
@inject ConfigurationService _configService
@inject IHostApplicationLifetime _lifetime
@inject CertificateService _certService

<PageHeader Title="@_strings["System Settings"]">
    <div class="help-text">@_strings["Version"]: @_version</div>
</PageHeader>

<PageContent>
    @if (_proxyConfig == null) {
        <LoadingIndicator />
        return;
    }

    <fieldset>
        <legend>@_strings["System Defaults"]</legend>

        <div>
            <Toggle FieldLabel="@_strings["Max Request Body Size"]" OffLabel="@_strings["Unlimited"]" IsOn="_proxyConfig.MaxRequestBodySize != null" OnLabel="@_strings["Limited"]" ToggleHandler="ToggleRequestBodySizeLimit" />
            @if (_proxyConfig.MaxRequestBodySize != null) {
                <label>
                    @_strings["Size In Bytes"]:
                    <input type="number" name="body-size" min="0" max="@long.MaxValue" @bind:get="_proxyConfig.MaxRequestBodySize" @bind:set="UpdateMaxRequestBodySize" />
                </label>
            }
            <div class="help-text">@_strings["Help_SystemMaxRequestBodySize"]</div>
        </div>
    </fieldset>

    <fieldset>
        <legend>@_strings["Management Site Settings"]</legend>

        <div>
            <label>
                @_strings["HTTPS Port"]:
                <input type="number" name="port" min="1" max="65535" @bind:get="_proxyConfig.AdminPort" @bind:set="UpdateAdminPort" />
            </label>
            <div class="help-text">@_strings["Help_AdminPort"]</div>
        </div>

        <div>
            <Toggle FieldLabel="@_strings["Listen On"]" OffLabel="@_strings["localhost"]" IsOn="@_proxyConfig.AdminListenAny" OnLabel="@_strings["Any IP"]" ToggleHandler="ListenOnToggled" />
            <div class="help-text">@_strings["Help_ListenOn"]</div>
        </div>

        <div>
            <div class="cert-select">
                <span>@_strings["HTTPS Certificate"]:</span>
                <span>@_proxyConfig.AdminCert.Name</span>
                <button class="action" @onclick="ViewAdminCertDetails">
                    <Icon Name="zoom" />
                </button>
                <button class="change" @onclick="ChangeAdminCert">
                    @_strings["Change"]
                </button>
            </div>
            <div class="help-text">@_strings["Help_AdminCert"]</div>
        </div>
    </fieldset>

    <PageCollapsibleSection Label="@_strings["Unmatched Traffic Handling"]">
        <Content>
            <StaticResponseEditor Response="_proxyConfig.UnmatchedResponse" ShowTarpit OnChanged="SaveChanges" />

            <fieldset>
                <legend>@_strings["NoSniMatch"]</legend>

                <div class="fallback">
                    <Toggle FieldLabel="@_strings["NoSniMatch"]"
                            OffLabel="@_strings["Refuse Connection"]"
                            IsOn="_proxyConfig.FallbackCert != null"
                            OnLabel="@_strings["Use Fallback Certificate"]"
                            ToggleHandler="FallbackCertToggled"
                            DisableToggleStateManagement />
                    @if (_proxyConfig.FallbackCert != null) {
                        <div class="cert-select">
                            <span>@_strings["Fallback Certificate"]:</span>
                            <span>@_proxyConfig.FallbackCert.Name</span>
                            <button class="action" @onclick="ViewFallbackCertDetails">
                                <Icon Name="zoom" />
                            </button>
                            <button class="change" @onclick="ChangeFallbackCert">
                                @_strings["Change"]
                            </button>
                        </div>
                    }
                    <div class="help-text">@_strings["Help_FallbackCert"]</div>
                </div>
            </fieldset>
        </Content>
        <CollapsedContent>
            <div class="collapsed-content">
                @foreach (var detail in _proxyConfig.UnmatchedResponse.SimulateResponse(_strings)) {
                    <div>@detail</div>
                }
            </div>
        </CollapsedContent>
    </PageCollapsibleSection>

    <PageCollapsibleSection Label="@_strings["Trusted Proxies"]">
        <Content>
            <fieldset>
                <legend>@_strings["Forwarded Client IP"]</legend>

                <div>
                    <Toggle FieldLabel="@_strings["Resolve Forwarded Client IP"]"
                            OffLabel="@_strings["Disable"]"
                            OnLabel="@_strings["Enable"]"
                            IsOn="_proxyConfig.TrustedProxyChainLimit > 0"
                            ToggleHandler="TrustedProxiesToggled"
                            DisableToggleStateManagement />
                    <div class="help-text">@_strings["Help_ForwardedClientIp"]</div>
                </div>

                @if (_proxyConfig.TrustedProxyChainLimit > 0) {
                    <div>
                        <label>
                            @_strings["Proxy Chain Limit"]:
                            <input type="number" min="1"
                                   @bind:get="_proxyConfig.TrustedProxyChainLimit"
                                   @bind:set="UpdateTrustedProxyChainLimit" />
                        </label>
                        <div class="help-text">@_strings["Help_TrustedProxyChainLimit"]</div>
                    </div>

                    <div>
                        <div class="trusted-proxy-actions">
                            <span>@_strings["Trusted Proxy Addresses"]:</span>
                            <button type="button" @onclick="EditTrustedProxies">
                                @_strings["Edit"]
                            </button>
                        </div>

                        @if (_proxyConfig.TrustedProxies.Count == 0) {
                            <div>@_strings["WARN_TrustedProxyEntriesEmpty"]</div>
                        } else {
                            <ul class="monospace">
                                @foreach (var entry in _proxyConfig.TrustedProxies.WithoutBlankAndCommentLines()) {
                                    <li>@entry</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </fieldset>
        </Content>
        <CollapsedContent>
            <div class="collapsed-content">
                @if (_proxyConfig.TrustedProxyChainLimit > 0) {
                    <div>@_strings["Proxy Chain Limit"]: @_proxyConfig.TrustedProxyChainLimit</div>
                    @if (_proxyConfig.TrustedProxies.Count == 0) {
                        <div>@_strings["WARN_TrustedProxyEntriesEmpty"]</div>
                    } else {
                        <div>@_strings["Trusted Proxies"]: @_proxyConfig.TrustedProxies.WithoutBlankAndCommentLines().Count()</div>
                    }
                } else {
                    @_strings["Disabled"]
                }
            </div>
        </CollapsedContent>
    </PageCollapsibleSection>

    <PageDivider Label="@_strings["Danger Zone"]" MarginTop="24px" />
    <div class="danger-zone">
        <div class="services">
            <LabelValuePairs>
                <LabelValuePair Label="@_strings["Startup Time"]" Value="@_proxyState.StartupTime.ToLocalTime().ToString("g")" />
            </LabelValuePairs>
            <button @onclick="RestartProxy">@_strings["Restart Proxy Server"]</button>
            <button @onclick="ShutdownProxy">@_strings["Shutdown Proxy Server"]</button>
        </div>
        <div class="backup-restore">
            <LabelValuePairs>
                <LabelValuePair Label="@_strings["Last Commit"]" Value="@_proxyState.RunningConfig.CommittedAt.ToLocalTime().ToString("g")" />
            </LabelValuePairs>
            <a href="/system/backup" class="button">@_strings["System Backup"]</a>
            <a href="/system/restore" class="button">@_strings["System Restore"]</a>
        </div>
        <div class="certificates">
            <a href="/system/configs" class="button">@_strings["ConfigurationCompareRestore"]</a>
            <a href="/system/cert-export" class="button">@_strings["Certificate Export"]</a>
            <a href="/system/cert-purge" class="button">@_strings["Certificate Purge Utility"]</a>
        </div>
    </div>
</PageContent>

